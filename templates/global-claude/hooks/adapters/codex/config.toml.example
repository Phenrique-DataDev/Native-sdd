# Exemplo de registro do adapter H5 no Codex CLI via config.toml (alternativa ao hooks.json).
# Copie o bloco relevante para ~/.codex/config.toml e ajuste o path do 'command'.
# NAO instalado automaticamente pelo onboarding -- opt-in manual. Ver docs/HARNESS-CONTRACT.md.
#
# ATENCAO -- COPIAR NAO BASTA: o Codex tem gate de CONFIANCA de hook. Todo hook nao-gerenciado
# nasce 'Untrusted' e NAO RODA -- em silencio, sem aviso, com o comando executando normalmente.
# Medido em 2026-08-04 (codex-cli 0.146.0): sem confiar, o hook nem e' invocado.
# Depois de copiar, faca UMA das duas:
#   (1) INTERATIVO (recomendado): abra o Codex e rode '/hooks' -- revise e confie no hook.
#       A confianca e' por HASH do comando: mudou o 'command', o status vira 'Modified' e
#       o hook para de rodar de novo ate ser reconfiado.
#   (2) AUTOMACAO: 'codex exec --dangerously-bypass-hook-trust ...' -- roda hook habilitado sem
#       confianca persistida. So para pipeline que ja auditou a origem do hook.
# Confira o estado com '/hooks' (TUI). Guard que nao dispara e' pior que guard ausente:
# a instalacao PARECE feita.

[[hooks.PreToolUse]]
matcher = "^Bash$"

[[hooks.PreToolUse.hooks]]
type = "command"
command = "pwsh -NoProfile -File ~/.codex/hooks/adapter-guard.ps1"
statusMessage = "Checando comando destrutivo (destructive-guard via adapter H5)"

[[hooks.PostToolUse]]
matcher = "^(Edit|Write)$"

[[hooks.PostToolUse.hooks]]
type = "command"
command = "pwsh -NoProfile -File ~/.codex/hooks/adapter-guard.ps1"

[[hooks.SessionStart]]

[[hooks.SessionStart.hooks]]
type = "command"
command = "pwsh -NoProfile -File ~/.codex/hooks/adapter-guard.ps1"
