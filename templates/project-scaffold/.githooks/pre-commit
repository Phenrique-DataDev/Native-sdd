#!/bin/sh
# pre-commit — bloqueia commit com segredo (rede DETERMINISTICA, independe do modelo/agente).
# Shim fino: escolhe o runtime e delega a varredura. Ativado por `git config core.hooksPath .githooks`
# (feito pelo onboarding/new-project.ps1).
#
# Ordem: PowerShell (secret-scan.ps1, a referencia) -> bash (secret-scan.sh, par POSIX com a mesma
# lib) -> nenhum dos dois: BLOQUEIA. Ate a 0.10.44 o ramo sem PowerShell saia 0 ("varredura de
# segredos PULADA") e o commit com token entrava no historico — medido num Mac real (2026-09-10)
# sob o PATH de app aberto pelo Dock (/usr/bin:/bin:/usr/sbin:/sbin, sem o /usr/local/bin do pwsh).
# Hook de segredo que passa calado e' pior do que hook que incomoda.
#
# Para pular conscientemente (NAO recomendado): git commit --no-verify
root="$(git rev-parse --show-toplevel)"
dir="$root/.githooks"

# Sem nenhum script de varredura, o projeto retirou a rede de proposito: nao ha o que rodar.
if [ ! -f "$dir/secret-scan.ps1" ] && [ ! -f "$dir/secret-scan.sh" ]; then
  exit 0
fi

if [ -f "$dir/secret-scan.ps1" ]; then
  if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File "$dir/secret-scan.ps1"
  elif command -v powershell >/dev/null 2>&1; then
    exec powershell -NoProfile -ExecutionPolicy Bypass -File "$dir/secret-scan.ps1"
  fi
fi

if [ -f "$dir/secret-scan.sh" ] && command -v bash >/dev/null 2>&1; then
  exec bash "$dir/secret-scan.sh"
fi

{
  echo ""
  echo "  COMMIT BLOQUEADO — nenhum runtime para varrer segredos neste PATH"
  echo "    (sem pwsh/powershell para o secret-scan.ps1, e sem bash ou secret-scan.sh para o par POSIX)."
  echo ""
  echo "  Instale um dos dois, ou, se voce conferiu o diff e ele esta limpo:"
  echo "    git commit --no-verify   (pula a verificacao conscientemente)"
  echo ""
} >&2
exit 1
